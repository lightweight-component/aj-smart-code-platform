{
  "name": "@ajax-js/configurable-widget",
  "version": "1.0.1",
  "private": false,
  "description": "Configurable Vue 3 components for quickly building data tables and forms with View UI Plus.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./target/npm/types/index.d.ts",
      "import": "./target/npm/index.js"
    },
    "./style.css": "./target/npm/style.css"
  },
  "files": ["target/npm"],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.41",
    "vue-router": "^4.5.1",
    "view-ui-plus": "^1.3.24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "codemirror": "^6.0.2",
    "vue-codemirror": "^6.1.1",
    "vue-draggable-plus": "^0.6.1"
  }
}
